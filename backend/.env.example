# Copy this file to .env inside the backend/ folder before running uvicorn locally.
# Never commit real secrets.

APP_NAME=AI Investment Research API
DEBUG=false

# Frontend origins allowed by CORS (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# LLM Providers — configured per-user via the AI Settings page in the UI.
# You can set defaults here; users can override in the app.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# -----------------------------------------------------------------------------
# News & Market Data APIs (Free Tiers)
# -----------------------------------------------------------------------------
ALPHA_VANTAGE_KEY=
NEWSAPI_KEY=
FINNHUB_KEY=

# -----------------------------------------------------------------------------
# Database — pick ONE approach
# -----------------------------------------------------------------------------
DATABASE_PATH=data/app.db
DATABASE_URL=

# -----------------------------------------------------------------------------
# Auth — JWT
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# -----------------------------------------------------------------------------
# PostgreSQL (used by docker-compose)
# -----------------------------------------------------------------------------
POSTGRES_DB=ai_investment
POSTGRES_USER=ai_app
POSTGRES_PASSWORD=Cr7m10p7!!
POSTGRES_PORT=5433

# -----------------------------------------------------------------------------
# Redis (optional locally)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
